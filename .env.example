DB_HOST=127.0.0.1
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=tutorlink_uc
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
# Campus time zone used by Node and by the MySQL session (Philippines)
APP_TZ=Asia/Manila
DB_TIMEZONE=+08:00
# Cookie SameSite policy: 'none' works in an embedded preview (Codespaces); use 'lax' for plain local use
COOKIE_SAMESITE=none
